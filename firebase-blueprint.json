{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A grocery product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "categoryId": { "type": "string" },
        "sellingPrice": { "type": "number" },
        "stock": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "brand", "categoryId", "sellingPrice", "stock"]
    },
    "Category": {
      "title": "Category",
      "description": "A product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "slug"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products collection"
    },
    "categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories collection"
    }
  }
}
