rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master Gate
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // For now, let's allow all auth to read, but we will harden it.
      // A real app would have an admins collection.
      return isSignedIn(); 
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
